         processing_cnt_d = pe_req_i.vl;
         read_cnt_d       = pe_req_i.vl;
 
+        // Masked loads/stores with vstart > 0: the VLDU/VSTU consume one mask entry per VRF word,
+        // starting with the word that holds element vstart. Skip the elements of the words below
+        // it (the lanes already skipped the whole mask beats among them).
+        if (pe_req_i.vfu inside {VFU_LoadUnit, VFU_StoreUnit} && !pe_req_i.vm) begin
+          automatic vlen_t skip_el = (pe_req_i.vstart / ((NrLanes * 8) >> pe_req_i.vtype.vsew)) *
+                                     ((NrLanes * 8) >> pe_req_i.vtype.vsew);
+          issue_cnt_d      = pe_req_i.vl - skip_el;
+          processing_cnt_d = pe_req_i.vl - skip_el;
+          read_cnt_d       = pe_req_i.vl - skip_el;
+          mask_pnt_d       = skip_el % (NrLanes * DataWidth);
+        end
+
         // Trim skipped words
         if (pe_req_i.op == VSLIDEUP) begin
           issue_cnt_d      -= vlen_t'(trimmed_stride);
